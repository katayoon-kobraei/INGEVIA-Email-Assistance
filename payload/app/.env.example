# Set automatically by the installer: PROCESSOR or VIEWER.
APP_MODE=PROCESSOR

# Required only on the processing computer.
GEMINI_API_KEY=

# Shared folder visible to the processing computer and every viewer PC.
# Prefer a UNC path, for example: \\OFFICE-SERVER\EmailAssistantData
SHARED_DATA_PATH=C:\EmailAssistant\Output

# Shared UI/state folder used by processor + viewers.
OUTPUT_ROOT=C:\EmailAssistant\Output

# Exact engineering year folder where processed emails and attachments belong.
# For the current office setup this is the existing folder P:\TRABAJOS 2026.
PROJECT_YEAR_ROOT=P:\TRABAJOS 2026

# Internal parent of PROJECT_YEAR_ROOT. The installer derives this automatically.
# Do not point this to Email Assistant Data.
ARCHIVE_ROOT=P:\

# Outlook processing.
FLAG_PROCESSED_EMAILS=true
PROCESSED_CATEGORY_NAME=IA - PROCESADO
ARCHIVE_JUNK_EMAILS=true
JUNK_ARCHIVE_FOLDER_NAME=Archivo
CHECK_PENDING_RESPONSES=true
PENDING_FOLDER_NAME=Pending Emails
LOOKBACK_MINUTES=35

# Included reference spreadsheet. The launcher starts in the app folder,
# so this relative path points to the packaged Folder_Data.xlsx file.
DESCRIPTIONS_XLSX_PATH=Folder_Data.xlsx
DESCRIPTION_MAX_CHARS=500

# Company-specific routing values from the supplied project.
BOSS_EMAIL=m.vera@ingevia.com
TARGET_MAILBOX=m.vera@ingevia.com
ADMINISTRACION_EMAIL=administracion@ingevia.com
INTERNAL_DOMAIN=ingevia.com
BILLING_OUTPUT_ROOT=X:\EMAILS
IGNORE_DOMAINS=ingevia.com
IGNORE_SENDERS=fmunoz@munozbosch.com
PLENERGY_SENDER_DOMAINS=plenergy.es,plainco.es
